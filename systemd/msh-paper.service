[Unit]
Description=MSH Paper 1.17.1
After=network.target

[Service]
User=minecraft
Group=gameservers
WorkingDirectory=/opt/minecraft/msh-paper
ExecStart=/opt/minecraft/msh-paper/msh
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
# Sandboxing : compte sans sudo ni SSH, écriture limitée à /opt/minecraft.
UMask=0007
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/minecraft
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
